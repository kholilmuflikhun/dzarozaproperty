generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum MembershipRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  FINANCE
  SALES
  STAFF
  CLIENT
}
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}
enum BillingCycle {
  MONTHLY
  YEARLY
}
enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}
enum DocumentStatus {
  PENDING_UPLOAD
  AVAILABLE
  QUARANTINED
  DELETED
}
enum ProjectStatus {
  DRAFT
  QUOTATION
  WAITING_APPROVAL
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  HANDOVER
  COMPLETED
  CANCELED
  ARCHIVED
}
enum ProjectDocumentType {
  QUOTATION
  WORK_AGREEMENT
  PAYMENT_SCHEDULE
  CHANGE_ORDER
  PROGRESS_REPORT
  INVOICE
  HANDOVER
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String?
  isPlatformAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  auditLogs AuditLog[]
  activations LicenseActivation[]
  platformAuditLogs PlatformAuditLog[]
  uploadedDocuments Document[]
}
model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  legalName String?
  timezone String @default("Asia/Jakarta")
  currency String @default("IDR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  subscriptions Subscription[]
  licenses License[]
  clients Client[]
  leads Lead[]
  projects Project[]
  projectWorkspaces ProjectWorkspace[]
  projectWorkItems ProjectWorkItem[]
  paymentTerms PaymentTerm[]
  changeOrders ChangeOrder[]
  progressReports ProgressReport[]
  quotations Quotation[]
  invoices Invoice[]
  payments PaymentTransaction[]
  expenses Expense[]
  auditLogs AuditLog[]
  documents Document[]
}
model Membership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role MembershipRole @default(STAFF)
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([organizationId,userId])
  @@index([userId])
  @@index([organizationId,role])
}
model Plan {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  isActive Boolean @default(true)
  monthlyPrice Decimal @db.Decimal(14,2)
  yearlyPrice Decimal @db.Decimal(14,2)
  currency String @default("IDR")
  maxUsers Int?
  maxProjects Int?
  maxStorageMb Int?
  maxActivations Int @default(1)
  featureFlags Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions Subscription[]
}
model Subscription {
  @@unique([organizationId,id])
  id String @id @default(cuid())
  organizationId String
  planId String
  status SubscriptionStatus @default(INCOMPLETE)
  billingCycle BillingCycle
  checkoutAmount Decimal? @db.Decimal(14,2)
  provider String @default("MIDTRANS")
  providerCustomerId String?
  providerSubscriptionId String? @unique
  providerOrderId String? @unique
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id])
  plan Plan @relation(fields:[planId],references:[id])
  licenses License[]
  billingEvents BillingEvent[]
  payments PaymentTransaction[]
  @@index([organizationId,status])
  @@index([currentPeriodEnd])
}
model License {
  id String @id @default(cuid())
  organizationId String
  subscriptionId String?
  keyHash String @unique
  keyPrefix String
  status LicenseStatus @default(ACTIVE)
  maxActivations Int @default(1)
  expiresAt DateTime?
  lastValidatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id])
  subscription Subscription? @relation(fields:[organizationId,subscriptionId],references:[organizationId,id],onDelete:NoAction)
  activations LicenseActivation[]
  @@index([organizationId,status])
}
model LicenseActivation {
  id String @id @default(cuid())
  licenseId String
  installationId String
  label String?
  fingerprintHash String
  activatedById String?
  activatedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  license License @relation(fields:[licenseId],references:[id],onDelete:Cascade)
  activatedBy User? @relation(fields:[activatedById],references:[id])
  @@unique([licenseId,installationId])
  @@index([licenseId,revokedAt])
}
model BillingEvent {
  id String @id @default(cuid())
  subscriptionId String?
  provider String
  providerEventId String @unique
  eventType String
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  failureReason String?
  subscription Subscription? @relation(fields:[subscriptionId],references:[id])
  @@index([provider,receivedAt])
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String
  actorId String?
  action String
  entityType String
  entityId String
  beforeState Json?
  afterState Json?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  actor User? @relation(fields:[actorId],references:[id])
  @@index([organizationId,createdAt])
  @@index([entityType,entityId])
}
model Client {
  @@unique([organizationId,id])
  id String @id @default(cuid())
  organizationId String
  name String
  email String?
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  leads Lead[]
  projects Project[]
  quotations Quotation[]
  @@index([organizationId,name])
  @@index([organizationId,email])
}
model Lead {
  id String @id @default(cuid())
  organizationId String
  clientId String?
  title String
  contactName String
  phone String?
  email String?
  source String?
  stage String @default("NEW")
  estimatedValue Decimal? @db.Decimal(14,2)
  followUpAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  client Client? @relation(fields:[organizationId,clientId],references:[organizationId,id],onDelete:NoAction)
  @@index([organizationId,stage])
  @@index([organizationId,followUpAt])
}
model Project {
  @@unique([organizationId,id])
  id String @id @default(cuid())
  organizationId String
  clientId String
  code String
  name String
  status ProjectStatus @default(DRAFT)
  contractValue Decimal @default(0) @db.Decimal(14,2)
  progress Int @default(0)
  startAt DateTime?
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  client Client @relation(fields:[organizationId,clientId],references:[organizationId,id],onDelete:NoAction)
  quotations Quotation[]
  invoices Invoice[]
  expenses Expense[]
  documents Document[]
  workspace ProjectWorkspace?
  workItems ProjectWorkItem[]
  paymentTerms PaymentTerm[]
  changeOrders ChangeOrder[]
  progressReports ProgressReport[]
  @@unique([organizationId,code])
  @@index([organizationId,status])
}
model ProjectWorkspace {
  id String @id @default(cuid())
  organizationId String
  projectId String
  businessName String?
  businessAddress String?
  businessPhone String?
  businessEmail String?
  businessOwnerName String?
  clientAddress String?
  siteAddress String?
  quotationDate DateTime?
  quotationValidDays Int @default(14)
  spkSignedAt DateTime?
  durationDays Int?
  documentSequence Int @default(1)
  bankName String?
  bankAccountNumber String?
  bankAccountName String?
  maintenanceDays Int @default(30)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:Cascade)
  @@unique([organizationId,projectId])
  @@index([organizationId,updatedAt])
}

model ProjectWorkItem {
  id String @id @default(cuid())
  organizationId String
  projectId String
  description String
  quantity Decimal @db.Decimal(14,3)
  unit String
  unitPrice Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  category String @default("WORK")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:Cascade)
  @@index([organizationId,projectId,sortOrder])
}

model PaymentTerm {
  id String @id @default(cuid())
  organizationId String
  projectId String
  sequence Int
  name String
  condition String
  percentage Decimal @db.Decimal(5,2)
  amount Decimal @db.Decimal(14,2)
  status String @default("UNPAID")
  dueAt DateTime?
  invoiceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:Cascade)
  @@unique([organizationId,projectId,sequence])
  @@index([organizationId,projectId,status])
}

model ChangeOrder {
  id String @id @default(cuid())
  organizationId String
  projectId String
  number String
  status String @default("DRAFT")
  reason String?
  notes String?
  addedTotal Decimal @default(0) @db.Decimal(14,2)
  deductedTotal Decimal @default(0) @db.Decimal(14,2)
  netTotal Decimal @default(0) @db.Decimal(14,2)
  agreedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:Cascade)
  items ChangeOrderItem[]
  @@unique([organizationId,number])
  @@unique([organizationId,id])
  @@index([organizationId,projectId,createdAt])
}

model ChangeOrderItem {
  id String @id @default(cuid())
  organizationId String
  changeOrderId String
  kind String
  description String
  quantity Decimal @db.Decimal(14,3)
  unit String
  unitPrice Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  sortOrder Int @default(0)
  changeOrder ChangeOrder @relation(fields:[organizationId,changeOrderId],references:[organizationId,id],onDelete:Cascade)
  @@index([organizationId,changeOrderId,sortOrder])
}

model ProgressReport {
  id String @id @default(cuid())
  organizationId String
  projectId String
  reportNumber String
  weekStart DateTime
  weekEnd DateTime
  overallProgress Int
  completedItems Json
  nextWeekPlans Json
  blockers String?
  clientDecision String?
  paymentStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:Cascade)
  @@unique([organizationId,reportNumber])
  @@index([organizationId,projectId,weekStart])
}

model Quotation {
  id String @id @default(cuid())
  organizationId String
  clientId String
  projectId String?
  number String
  status String @default("DRAFT")
  subtotal Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  tax Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  issuedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  client Client @relation(fields:[organizationId,clientId],references:[organizationId,id],onDelete:NoAction)
  project Project? @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:NoAction)
  items QuotationItem[]
  invoices Invoice[]
  approvalTokenHash String? @unique
  approvalTokenExpiresAt DateTime?
  approvalTokenUsedAt DateTime?
  @@unique([organizationId,id])
  @@unique([organizationId,number])
  @@index([organizationId,status])
}
model QuotationItem {
  id String @id @default(cuid())
  organizationId String
  quotationId String
  description String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  quotation Quotation @relation(fields:[organizationId,quotationId],references:[organizationId,id],onDelete:Cascade)
  @@index([organizationId,quotationId,sortOrder])
}
model Invoice {
  @@unique([organizationId,id])
  id String @id @default(cuid())
  organizationId String
  projectId String?
  quotationId String?
  number String
  status String @default("DRAFT")
  subtotal Decimal @default(0) @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  tax Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  paidAmount Decimal @default(0) @db.Decimal(14,2)
  dueAt DateTime?
  issuedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:NoAction)
  quotation Quotation? @relation(fields:[organizationId,quotationId],references:[organizationId,id],onDelete:NoAction)
  items InvoiceItem[]
  payments PaymentTransaction[]
  documents Document[]
  @@unique([organizationId,number])
  @@index([organizationId,status,dueAt])
  @@unique([organizationId,quotationId])
  @@index([organizationId,quotationId])
}
model InvoiceItem {
  id String @id @default(cuid())
  organizationId String
  invoiceId String
  description String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields:[organizationId,invoiceId],references:[organizationId,id],onDelete:Cascade)
  @@index([organizationId,invoiceId,sortOrder])
}
model PaymentTransaction {
  id String @id @default(cuid())
  organizationId String
  invoiceId String?
  subscriptionId String?
  provider String
  providerRef String? @unique
  providerOrderId String? @unique
  checkoutToken String?
  checkoutUrl String?
  amount Decimal @db.Decimal(14,2)
  currency String @default("IDR")
  status String @default("PENDING")
  paidAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  invoice Invoice? @relation(fields:[organizationId,invoiceId],references:[organizationId,id],onDelete:NoAction)
  subscription Subscription? @relation(fields:[organizationId,subscriptionId],references:[organizationId,id],onDelete:NoAction)
  @@index([organizationId,status])
}
model Expense {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  category String
  description String?
  amount Decimal @db.Decimal(14,2)
  incurredAt DateTime
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:NoAction)
  @@index([organizationId,incurredAt])
}
model PlatformAuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityType String
  entityId String
  beforeState Json?
  afterState Json?
  metadata Json?
  createdAt DateTime @default(now())
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@index([actorId,createdAt])
  @@index([entityType,entityId])
}

model PublicRateLimitBucket {
  key String @id
  count Int @default(0)
  windowStartedAt DateTime
  resetAt DateTime
  @@index([resetAt])
}

model Document {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  invoiceId String?
  uploadedById String?
  fileName String
  objectKey String @unique
  contentType String
  sizeBytes BigInt
  checksumSha256 String?
  etag String?
  status DocumentStatus @default(PENDING_UPLOAD)
  documentType ProjectDocumentType?
  documentNumber String?
  version Int @default(1)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[organizationId,projectId],references:[organizationId,id],onDelete:NoAction)
  invoice Invoice? @relation(fields:[organizationId,invoiceId],references:[organizationId,id],onDelete:NoAction)
  uploadedBy User? @relation(fields:[uploadedById],references:[id],onDelete:SetNull)
  parentDocumentId String?
  parentDocument Document? @relation("DocumentRevisions", fields:[organizationId,parentDocumentId], references:[organizationId,id], onDelete:NoAction)
  revisions Document[] @relation("DocumentRevisions")
  @@unique([organizationId,id])
  @@index([organizationId,status,createdAt])
  @@index([organizationId,parentDocumentId,version])
  @@index([organizationId,projectId])
  @@index([organizationId,invoiceId])
  @@index([uploadedById])
}
