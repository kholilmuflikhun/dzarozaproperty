# Copy to apps/ops/.env.local
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_ADMIN_EMAILS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dzaroza?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dzaroza?schema=public
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Cloudflare R2 — configure only after R2 is enabled and private buckets exist.
# Use environment-specific credentials; never reuse Preview credentials in Production.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Optional. Leave empty for private buckets; prefer short-lived signed download URLs.
R2_PUBLIC_BASE_URL=
