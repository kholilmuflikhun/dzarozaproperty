{
  "name": "@dzaroza/ops",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "pnpm --filter @dzaroza/database db:generate && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@dzaroza/database": "workspace:*",
    "@dzaroza/shared": "workspace:*",
    "@vinext/cloudflare": "^1.3.3",
    "better-auth": "1.7.16",
    "lucide-react": "^1.61.0",
    "midtrans-client": "^1.4.3",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.27",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module"
}
