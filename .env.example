# Salin file ini menjadi ".env.local" lalu isi sesuai environment Anda.

# --- Vercel Blob (upload foto lewat /admin/upload) ---
# BLOB_READ_WRITE_TOKEN otomatis terisi begitu Anda membuat Blob store di
# Vercel Dashboard -> Storage -> Create Database -> Blob, dan menghubungkannya
# ke project ini. Untuk development lokal, jalankan: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=""
# Secret upload aktif. Rotasi: isi secret baru di UPLOAD_SECRET dan secret lama
# sementara di UPLOAD_SECRET_PREVIOUS, lalu hapus variable PREVIOUS setelah semua
# admin memakai secret baru.
UPLOAD_SECRET="ganti-dengan-secret-acak-panjang-baru"
UPLOAD_SECRET_PREVIOUS=""

# --- Site URL (wajib diisi valid, dipakai untuk metadata & favicon) ---
# Untuk lokal: http://localhost:3000
# Untuk produksi: URL domain Vercel/domain kustom Anda, HARUS diisi (jangan dikosongkan),
# kalau kosong build akan gagal dengan error "Invalid URL".
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- NextAuth (Login with Google di form Testimoni) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="isi-dengan-string-acak-panjang" # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Email Google yang boleh mengakses /admin/upload, pisahkan dengan koma.
ADMIN_EMAILS="admin@example.com"

# --- Upstash Redis (wajib untuk production order & rate limit global) ---
# Buat database di https://console.upstash.com/ lalu salin REST URL dan token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Google Sheets API (menyimpan submit form testimoni) ---
# Buat Service Account di Google Cloud Console, aktifkan Google Sheets API,
# lalu bagikan Spreadsheet tujuan ke email service account tsb (role: Editor).
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_RANGE="Testimoni!A:G"

# --- Payment Gateway (Midtrans Snap) ---
# Dapatkan dari dashboard.midtrans.com -> Settings -> Access Keys
# Gunakan SB- (SANDBOX) untuk testing, lalu ganti ke live key saat go-live.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# --- Kontak Default ---
NEXT_PUBLIC_WHATSAPP_PRIMARY="6287837403432"

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-ZL9M35ZXXM"